{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SuccessFactors": {
    "SuccessFactorsBaseUrl": "https://sandbox.api.sap.com/successfactors/odata/v2",
    "DownstreamScope": "api://<successfactors-api-client-id>/.default"
  },
  "AzureAd": {
    "TenantId": "<tenant-guid>",
    "ClientId": "<mcp-client-id>",
    "ClientSecret": "<client-secret-or-managed-identity-assertion>",
    "Audience": "api://<mcp-api-app-id>"
  },
  "Mcp": {
    "ServerName": "SuccessFactors TimeOff MCP",
    "Version": "1.0.0"
  }
}
